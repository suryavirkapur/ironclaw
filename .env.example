# Copy this file to .env and replace the placeholders.
# .env is ignored by Git; never commit real credentials.
# Used for OpenAI-compatible providers too (the supplied configs use OpenRouter).
OPENAI_API_KEY=replace-with-your-llm-provider-api-key
BRAVE_API_KEY=replace-with-your-brave-search-api-key
TELEGRAM_BOT_TOKEN=replace-with-your-botfather-token
OWNER_TELEGRAM_CHAT_ID=replace-with-your-numeric-chat-id
# Generate with: openssl rand -hex 32
IRONCLAW_CONTROL_PLANE_TOKEN=replace-with-at-least-32-random-characters
